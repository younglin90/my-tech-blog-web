# Cloudflare Pages _headers — 정적 자산 캐시 정책 + 보안 헤더
# 형식: 경로 패턴 + 들여쓰기된 헤더 라인

# Next.js 빌드 자산 — 컨텐츠 해시 포함, 영구 캐시
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# KaTeX self-hosted (해시 없음 → 1주일 + revalidate)
/katex/*
  Cache-Control: public, max-age=604800, must-revalidate

# 폰트 (next/font 출력)
/_next/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# 이미지·아이콘
/favicon.ico
  Cache-Control: public, max-age=86400
/icon.svg
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# OG 이미지 (포스트당 1.2MB 정도, 빌드 시 정적 생성됨)
/*/posts/*/opengraph-image
  Cache-Control: public, max-age=604800
/*/opengraph-image
  Cache-Control: public, max-age=604800

# RSS·sitemap — 자주 갱신되니 짧게
/feed.xml
  Cache-Control: public, max-age=300, s-maxage=900
/feed.json
  Cache-Control: public, max-age=300, s-maxage=900
/feed-*.xml
  Cache-Control: public, max-age=300, s-maxage=900
/feed-*.json
  Cache-Control: public, max-age=300, s-maxage=900
/sitemap.xml
  Cache-Control: public, max-age=900, s-maxage=3600
/sitemap/*
  Cache-Control: public, max-age=900, s-maxage=3600

# robots.txt / manifest
/robots.txt
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Service Worker 자체는 절대 캐시 금지 — 새 배포 즉시 반영되어야 함
/sw.js
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Service-Worker-Allowed: /

# 클라이언트 색인 — 새 글/검색/추천 목록이 배포 직후 보이도록 저장 금지
/post-index.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/rag-index.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# HTML 페이지 — 신규 포스트와 정적 export 라우트가 배포 직후 보이도록 저장 금지
# 더 구체적인 위 규칙(_next/static, opengraph-image 등)이 자동으로 우선 적용됨.
/
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/ko/*
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/en/*
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/ja/*
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/zh/*
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/es/*
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# 보안 헤더 (모든 페이지)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
