# Cloudflare Pages _headers — 정적 자산 캐시 정책 + 보안 헤더
# 형식: 경로 패턴 + 들여쓰기된 헤더 라인

# Next.js 빌드 자산 — 컨텐츠 해시 포함, 영구 캐시
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# KaTeX self-hosted (해시 없음 → 1주일 + revalidate)
/katex/*
  Cache-Control: public, max-age=604800, must-revalidate

# 폰트 (next/font 출력)
/_next/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# 이미지·아이콘
/favicon.ico
  Cache-Control: public, max-age=86400
/icon.svg
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# OG 이미지 — 확장자 없는 경로라 Content-Type이 추측된다. 명시하지 않으면
# 소셜 크롤러와 Google 이미지가 PNG로 인식하지 못한다.
/*/posts/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=604800, immutable
/*/opengraph-image
  Content-Type: image/png
  Cache-Control: public, max-age=604800, immutable

# RSS·sitemap — 자주 갱신되니 짧게
/feed.xml
  Cache-Control: public, max-age=300, s-maxage=900
/feed.json
  Cache-Control: public, max-age=300, s-maxage=900
/feed-*.xml
  Cache-Control: public, max-age=300, s-maxage=900
/feed-*.json
  Cache-Control: public, max-age=300, s-maxage=900
# sitemap은 Content-Type을 반드시 명시한다.
# 아래 /* 규칙의 X-Content-Type-Options: nosniff 때문에, 타입이 XML이 아니면
# Google 사이트맵 파서가 내용을 추측하지 않고 그대로 거부한다("가져올 수 없음").
# URL 검사 도구는 Content-Type을 따지지 않아서 통과하므로 증상이 사이트맵에만 나타난다.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=900, s-maxage=3600
/sitemap/*
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=900, s-maxage=3600

# robots.txt / manifest
/robots.txt
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# Service Worker 자체는 절대 캐시 금지 — 새 배포 즉시 반영되어야 함
/sw.js
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
  Service-Worker-Allowed: /

# 클라이언트 색인 — 새 글/검색/추천 목록이 배포 직후 보이도록 저장 금지
/post-index.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/rag-index.json
  Cache-Control: no-store, max-age=0
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# HTML 페이지 — 배포 즉시 반영은 유지하되 no-store는 쓰지 않는다.
# no-store는 bfcache를 비활성화하고 뒤로/앞으로 갈 때마다 400~600KB 문서를
# 통째로 다시 내려받게 만든다. no-cache는 매 요청 재검증하되 변경이 없으면
# 304 + 본문 0바이트로 끝나고, bfcache도 정상 동작한다.
# 더 구체적인 위 규칙(_next/static, opengraph-image 등)이 자동으로 우선 적용됨.
/
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/ko/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/en/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/ja/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/zh/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
/es/*
  Cache-Control: public, max-age=0, must-revalidate
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

# 보안 헤더 (모든 페이지)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
