# Cloudflare Pages _headers — 정적 자산 캐시 정책 + 보안 헤더
# 형식: 경로 패턴 + 들여쓰기된 헤더 라인

# Next.js 빌드 자산 — 컨텐츠 해시 포함, 영구 캐시
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# KaTeX self-hosted (해시 없음 → 1주일 + revalidate)
/katex/*
  Cache-Control: public, max-age=604800, must-revalidate

# 폰트 (next/font 출력)
/_next/static/media/*
  Cache-Control: public, max-age=31536000, immutable

# 이미지·아이콘
/favicon.ico
  Cache-Control: public, max-age=86400
/icon.svg
  Cache-Control: public, max-age=86400
/icon-192.png
  Cache-Control: public, max-age=2592000
/icon-512.png
  Cache-Control: public, max-age=2592000
/apple-touch-icon.png
  Cache-Control: public, max-age=2592000

# OG 이미지 (포스트당 1.2MB 정도, 빌드 시 정적 생성됨)
/*/posts/*/opengraph-image
  Cache-Control: public, max-age=604800
/*/opengraph-image
  Cache-Control: public, max-age=604800

# RSS·sitemap — 자주 갱신되니 짧게
/feed.xml
  Cache-Control: public, max-age=300, s-maxage=900
/feed.json
  Cache-Control: public, max-age=300, s-maxage=900
/feed-*.xml
  Cache-Control: public, max-age=300, s-maxage=900
/feed-*.json
  Cache-Control: public, max-age=300, s-maxage=900
/sitemap.xml
  Cache-Control: public, max-age=900, s-maxage=3600
/sitemap/*
  Cache-Control: public, max-age=900, s-maxage=3600

# robots.txt / manifest
/robots.txt
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400

# 보안 헤더 (모든 페이지)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=(), browsing-topics=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
