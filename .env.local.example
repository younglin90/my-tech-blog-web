# Admin password
# /admin 은 Cloudflare Pages Function(functions/_middleware.ts)이 Basic Auth로 막는다.
# Pages → Settings → Variables and Secrets 에 ADMIN_PASSWORD 를 Secret으로 등록한다.
# (브라우저 번들에 들어가므로 NEXT_PUBLIC_ 으로 두지 않는다.)

# ── Canonical Site URL (recommended) ────────────────────────────────────
# canonical/og/sitemap/rss 절대 URL 기준 도메인.
# Cloudflare Pages production 환경에서 반드시 설정 권장.
# 예시: NEXT_PUBLIC_SITE_URL=https://cfdblog.cc
# NEXT_PUBLIC_SITE_URL=

# ── Search Console verification (optional) ──────────────────────────────
# 빌드 시 <head>에 자동 주입. 등록 안 해도 사이트 동작에 영향 없음.
# Google: https://search.google.com/search-console → 속성 추가 → HTML 태그 → content="..."
# Bing: https://www.bing.com/webmasters → 사이트 추가 → HTML 태그 → content="..."
# Naver: https://searchadvisor.naver.com → 사이트 등록 → HTML 태그 → content="..."
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_NAVER_VERIFICATION=

# 등록 후 sitemap 제출:
#   Google Search Console → Sitemaps → https://cfdblog.cc/sitemap.xml
#   Bing Webmaster Tools → Sitemaps → https://cfdblog.cc/sitemap.xml
#   Naver Search Advisor → 요청 → 사이트맵 제출 → /sitemap.xml

# ── 댓글 ───────────────────────────────────────────────────────────────
# 댓글은 Cloudflare D1(바인딩명 DB)에 저장된다 — functions/api/comments.ts. 별도 환경변수 없음.
# 숨김/복원은 /admin 대시보드 하단 (ADMIN_PASSWORD Basic Auth).

# ── Newsletter (Buttondown, optional) ───────────────────────────────────
# 무료 플랜 100명까지. 미설정 시 RSS 안내 폴백.
# https://buttondown.email 가입 → Settings → Username
# NEXT_PUBLIC_BUTTONDOWN_USERNAME=

# ── Monetization ─────────────────────────────────────────────────────────
# 공개 빌드 값이다. API 키·비밀번호·결제 정보는 절대 넣지 않는다.
#
# AdSense 자동광고: client만 설정하고 AdSense 콘솔에서 Auto ads를 켠다.
# 수동 본문 광고: 별도 Display ad unit을 만든 뒤 slot도 설정한다.
# 기본값: ca-pub-8224726790382223 (환경변수로 다른 계정을 지정할 때만 설정)
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-1234567890123456
# NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=1234567890
#
# CFD 프로젝트 검토 CTA. URL이 비어 있으면 CTA는 렌더되지 않는다.
# Tally/Google Form/Calendly/이메일 등 실제로 문의를 받을 수 있는 주소를 사용한다.
# NEXT_PUBLIC_CFD_REVIEW_URL=https://example.com/cfd-review
# NEXT_PUBLIC_CFD_REVIEW_PRICE_KRW=100000
#
# 후원 링크. 가입한 서비스만 설정한다. URL은 결제 정보가 아닌 공개 공유 링크만 넣는다.
# 공통 URL 하나만 있으면 커피/맥주가 같은 결제 페이지를 연다.
# 서비스가 금액별 링크를 지원하면 아래 두 URL을 따로 넣어 선택 단계를 줄인다.
# NEXT_PUBLIC_SUPPORT_URL=https://example.com/your-support-page
# NEXT_PUBLIC_SUPPORT_COFFEE_URL=https://example.com/your-coffee-link
# NEXT_PUBLIC_SUPPORT_BEER_URL=https://example.com/your-beer-link
#
# 레거시 폴백. BMC는 핸들만, Toss는 공개 송금 링크 전체 URL.
# NEXT_PUBLIC_SUPPORT_GITHUB_SPONSORS=
# NEXT_PUBLIC_SUPPORT_BMC=
# NEXT_PUBLIC_SUPPORT_TOSS=
