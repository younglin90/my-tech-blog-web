# Admin password (SHA-256 hash)
# Generate with: node -e "crypto.subtle.digest('SHA-256', new TextEncoder().encode('your-password')).then(b => console.log(Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,'0')).join('')))"
# Or in browser console: await crypto.subtle.digest('SHA-256', new TextEncoder().encode('yourpassword')).then(b => Array.from(new Uint8Array(b)).map(x=>x.toString(16).padStart(2,'0')).join(''))
NEXT_PUBLIC_ADMIN_PASSWORD_HASH=

# ── Umami Analytics (optional) ──────────────────────────────────────────
# 브라우저에서 로드되는 tracking script (둘 다 설정되어야 script 주입됨)
# Umami Cloud 기본값:
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# 아래 3개는 Cloudflare Pages → Settings → Environment variables 에 등록.
# /api/visitors Pages Function이 서버 쪽에서만 사용 (클라이언트 노출 X).
# UMAMI_API_URL=https://api.umami.is/v1
# UMAMI_API_KEY=<Umami profile에서 발급한 API Key>
# UMAMI_WEBSITE_ID=<사이트 설정의 Website ID>

# ── Search Console verification (optional) ──────────────────────────────
# 빌드 시 <head>에 자동 주입. 등록 안 해도 사이트 동작에 영향 없음.
# Google: https://search.google.com/search-console → 속성 추가 → HTML 태그 → content="..."
# Bing: https://www.bing.com/webmasters → 사이트 추가 → HTML 태그 → content="..."
# Naver: https://searchadvisor.naver.com → 사이트 등록 → HTML 태그 → content="..."
# NEXT_PUBLIC_GOOGLE_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_NAVER_VERIFICATION=

# 등록 후 sitemap 제출:
#   Google Search Console → Sitemaps → https://cfdblog.cc/sitemap.xml
#   Bing Webmaster Tools → Sitemaps → https://cfdblog.cc/sitemap.xml
#   Naver Search Advisor → 요청 → 사이트맵 제출 → /sitemap.xml
