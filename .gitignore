# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# contentlayer
/.contentlayer/

# bkit runtime state (auto-generated, not source)
.bkit/audit/
.bkit/state/
.bkit/runtime/
.bkit/snapshots/

# firebase debug
/firebase-debug.log
__pycache__/
.pytest_cache/

# personal source documents (private, do not upload)
/해석기법 정리/
/원본/

# python virtual env
/.venv/
/venv/
